PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/nail-atelier

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin allowed to call this API
CLIENT_URL=http://localhost:5173

# AI Beauty Concierge (Atelier AI) — uses the Anthropic API
AI_PROVIDER=anthropic
AI_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-sonnet-5

# Seed script — creates this admin account the first time you run "npm run seed"
ADMIN_EMAIL=admin@nailatelier.test
ADMIN_PASSWORD=ChangeMe123!
